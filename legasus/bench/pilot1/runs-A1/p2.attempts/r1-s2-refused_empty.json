    "prompt": "<!DOCTYPE html>\n<html>\n<head>\n<title>Team directory</title>\n<style>\n  body { font-family: sans-serif; }\n  table { border-collapse: collapse; }\n  td { padding: 4px 12px; border-bottom: 1px solid #ddd; }\n  .gone { display: none; }\n</style>\n</head>\n<body>\n<h2>Team directory</h2>\n<label for=\"q\">Find someone</label>\n<input type=\"search\" id=\"q\">\n<table id=\"people\">\n  <tbody>\n    <tr class=\"person\"><td>Alvarez</td></tr>\n    <tr class=\"person\"><td>Okonkwo</td></tr>\n    <tr class=\"person\"><td>Petrov</td></tr>\n    <tr class=\"person\"><td>Nakamura</td></tr>\n    <tr class=\"person\"><td>Alberts</td></tr>\n    <tr class=\"person\"><td>Duarte</td></tr>\n  </tbody>\n</table>\n<script>\n(function () {\n  var box = document.getElementById('q');\n  var people = document.getElementById('people');\n  function render() {\n    var needle = box.value.trim().toLowerCase();\n    var all = people.querySelectorAll('.person');\n    for (var i = 0; i < all.length; i++) {\n      var name = all[i].textContent.toLowerCase();\n      if (needle === '' || name.indexOf(needle) !== -1) {\n        all[i].classList.remove('gone');\n      } else {\n        all[i].classList.add('gone');\n      }\n    }\n  }\n  box.addEventListener('keyup', render);\n  box.addEventListener('input', render);\n})();\n// create #clear-filter and attach the handler that does the work\n// FACT: this file defines render()\n// FACT: a keyup on input#q handler is registered\n// FACT: a input on input#q handler is registered\n// when #clear-filter is clicked: #q is empty; every item in the list is visible again. Ensure typing in the filter still narrows the list.\n",
