{
  "entry": "index.html",
  "stateExpr": "window.app && window.app.state ? window.app.state() : null",
  "contract": "The visible result is the evidence; a state accessor is used only when the page exposes one.",
  "steps": [
    {
      "n": 1,
      "name": "loads with no page or console error, in its starting state",
      "do": [],
      "expect": "errors.length === 0 && JSON.stringify(dom.visible) === \"[\\\"g2\\\",\\\"position 0\\\",\\\"X\\\",\\\".\\\",\\\".\\\"]\""
    },
    {
      "n": 2,
      "name": "press ArrowRight produces the result it already produces",
      "do": [
        {
          "kind": "key",
          "key": "ArrowRight"
        }
      ],
      "expect": "JSON.stringify(dom.visible) === \"[\\\"g2\\\",\\\"position 1\\\",\\\".\\\",\\\"X\\\",\\\".\\\"]\""
    },
    {
      "n": 3,
      "name": "pressing 0 returns the visible result to its starting state",
      "do": [
        {
          "kind": "key",
          "key": "0"
        }
      ],
      "expect": "JSON.stringify(dom.visible) === \"[\\\"g2\\\",\\\"position 0\\\",\\\"X\\\",\\\".\\\",\\\".\\\"]\""
    },
    {
      "n": 4,
      "name": "pressing 0 again leaves it at the starting state",
      "do": [
        {
          "kind": "key",
          "key": "0"
        }
      ],
      "expect": "JSON.stringify(dom.visible) === \"[\\\"g2\\\",\\\"position 0\\\",\\\"X\\\",\\\".\\\",\\\".\\\"]\""
    },
    {
      "n": 5,
      "name": "no page or console error was raised at any point",
      "do": [],
      "expect": "noErrors"
    }
  ]
}
