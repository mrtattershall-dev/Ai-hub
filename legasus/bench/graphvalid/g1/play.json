{
  "entry": "index.html",
  "stateExpr": "window.app && window.app.state ? window.app.state() : null",
  "contract": "The visible result is the evidence; a state accessor is used only when the page exposes one.",
  "steps": [
    {
      "n": 1,
      "name": "loads with no page or console error, showing every item",
      "do": [],
      "expect": "errors.length === 0 && JSON.stringify(dom.visible.filter((t) => [\"alpha\",\"alto\",\"bravo\",\"cedar\",\"delta\"].includes(t))) === \"[\\\"alpha\\\",\\\"alto\\\",\\\"bravo\\\",\\\"cedar\\\",\\\"delta\\\"]\""
    },
    {
      "n": 2,
      "name": "typing \"alph\" narrows the list as it already does",
      "do": [
        {
          "kind": "type",
          "selector": "#q",
          "text": "alph"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"alpha\",\"alto\",\"bravo\",\"cedar\",\"delta\"].includes(t))) === \"[\\\"alpha\\\"]\""
    },
    {
      "n": 3,
      "name": "clicking #reset-filter brings every item back",
      "do": [
        {
          "kind": "click",
          "selector": "#reset-filter"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"alpha\",\"alto\",\"bravo\",\"cedar\",\"delta\"].includes(t))) === \"[\\\"alpha\\\",\\\"alto\\\",\\\"bravo\\\",\\\"cedar\\\",\\\"delta\\\"]\""
    },
    {
      "n": 4,
      "name": "and leaves #q empty",
      "do": [],
      "expect": "dom.inputValues[\"#q\"] === ''"
    },
    {
      "n": 5,
      "name": "filtering still narrows the list afterwards",
      "do": [
        {
          "kind": "type",
          "selector": "#q",
          "text": "alph"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"alpha\",\"alto\",\"bravo\",\"cedar\",\"delta\"].includes(t))) === \"[\\\"alpha\\\"]\""
    },
    {
      "n": 6,
      "name": "clicking #reset-filter a second time brings every item back again",
      "do": [
        {
          "kind": "click",
          "selector": "#reset-filter"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"alpha\",\"alto\",\"bravo\",\"cedar\",\"delta\"].includes(t))) === \"[\\\"alpha\\\",\\\"alto\\\",\\\"bravo\\\",\\\"cedar\\\",\\\"delta\\\"]\""
    },
    {
      "n": 7,
      "name": "no page or console error was raised at any point",
      "do": [],
      "expect": "noErrors"
    }
  ]
}
