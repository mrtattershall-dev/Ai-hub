        "text": "```html\n<!DOCTYPE html>\n<html>\n<head>\n  <title>Ledger</title>\n</head>\n<body>\n  <h2>Ledger</h2>\n  <input id=\"find\" type=\"text\">\n  <span id=\"match-count\">0 items visible</span>\n  <button id=\"clear-filter\">Clear Filter</button>\n  <table id=\"book\"><tbody>\n    <tr class=\"line\"><td>Freight</td></tr>\n    <tr class=\"line\"><td>Freezer</td></tr>\n    <tr class=\"line\"><td>Postage</td></tr>\n    <tr class=\"line\"><td>Postal</td></tr>\n    <tr class=\"line\"><td>Utilities</td></tr>\n  </tbody></table>\n  <script>\n    var lines = [].slice.call(document.querySelectorAll('#book .line'));\n    var finder = document.getElementById('find');\n    var clearFilter = document.getElementById('clear-filter');\n    var matchCount = document.getElementById('match-count');\n\n    function updateMatchCount() {\n      var visibleCount = lines.filter(function (tr) {\n        return tr.style.display !== 'none';\n      }).length;\n      matchCount.textContent = visibleCount + ' items visible';\n    }\n\n    function sift() {\n      var q = finder.value.toLowerCase();\n      lines.forEach(function (tr) {\n        tr.style.display = tr.textContent.toLowerCase().indexOf(q) === -1 ? 'none' : '';\n      });\n      updateMatchCount();\n    }\n\n    document.addEventListener('input', function (e) {\n      if (e.target && e.target.id === 'find') sift();\n    });\n\n    clearFilter.addEventListener('click', function () {\n      finder.value = '';\n      lines.forEach(function (tr) {\n        tr.style.display = '';\n      });\n      updateMatchCount();\n    });\n\n    document.addEventListener('keydown', function (e) {\n      if (e.key === 'Escape') {\n        finder.value = '';\n        lines.forEach(function (tr) {\n          tr.style.display = '';\n        });\n        updateMatchCount();\n      }\n    });\n\n    // Initialize match count\n    updateMatchCount();\n  </script>\n</body>\n</html>\n```",
