{
  "entry": "index.html",
  "stateExpr": "window.app && window.app.state ? window.app.state() : null",
  "contract": "accumulating obligations",
  "steps": [
    {
      "n": 1,
      "name": "loads with no page or console error, showing every item",
      "do": [],
      "expect": "errors.length === 0 && JSON.stringify(dom.visible.filter((t) => [\"Okafor\",\"Okamoto\",\"Lindqvist\",\"Ferreira\",\"Novak\"].includes(t))) === \"[\\\"Okafor\\\",\\\"Okamoto\\\",\\\"Lindqvist\\\",\\\"Ferreira\\\",\\\"Novak\\\"]\""
    },
    {
      "role": "setup",
      "n": 2,
      "name": "typing \"okaf\" narrows the list",
      "do": [
        {
          "kind": "type",
          "selector": "#search",
          "text": "okaf"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"Okafor\",\"Okamoto\",\"Lindqvist\",\"Ferreira\",\"Novak\"].includes(t))) === \"[\\\"Okafor\\\"]\""
    },
    {
      "role": "addition",
      "n": 3,
      "name": "clicking #clear-filter brings every item back",
      "do": [
        {
          "kind": "click",
          "selector": "#clear-filter"
        }
      ],
      "expect": "JSON.stringify(dom.visible.filter((t) => [\"Okafor\",\"Okamoto\",\"Lindqvist\",\"Ferreira\",\"Novak\"].includes(t))) === \"[\\\"Okafor\\\",\\\"Okamoto\\\",\\\"Lindqvist\\\",\\\"Ferreira\\\",\\\"Novak\\\"]\""
    },
    {
      "role": "addition",
      "n": 4,
      "name": "and leaves #search empty",
      "do": [],
      "expect": "dom.inputValues[\"#search\"] === ''"
    },
    {
      "n": 5,
      "name": "no page or console error was raised at any point",
      "do": [],
      "expect": "noErrors"
    }
  ]
}
