{
  "entry": "index.html",
  "stateExpr": "window.app.state()",
  "contract": "The page must expose window.app.state() returning every piece of state it keeps.",
  "steps": [
    {
      "n": 1,
      "name": "loads with no page or console error, in its starting state",
      "do": [],
      "expect": "errors.length === 0 && JSON.stringify(state) === \"{\\\"playerAScore\\\":0,\\\"playerBScore\\\":0}\""
    },
    {
      "n": 2,
      "name": "pressing a changes the state as it already did",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerAScore\\\":1,\\\"playerBScore\\\":1}\""
    },
    {
      "n": 3,
      "name": "pressing a again changes it again",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerAScore\\\":2,\\\"playerBScore\\\":2}\""
    },
    {
      "n": 4,
      "name": "pressing 0 returns every piece of state to its starting value",
      "do": [
        {
          "key": "0"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerAScore\\\":0,\\\"playerBScore\\\":0}\""
    },
    {
      "n": 5,
      "name": "pressing 0 again leaves it at the starting value",
      "do": [
        {
          "key": "0"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerAScore\\\":0,\\\"playerBScore\\\":0}\""
    },
    {
      "n": 6,
      "name": "after 0, pressing a still changes the state",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) !== \"{\\\"playerAScore\\\":0,\\\"playerBScore\\\":0}\""
    },
    {
      "n": 7,
      "name": "no page or console error was raised at any point",
      "do": [],
      "expect": "noErrors"
    }
  ]
}
