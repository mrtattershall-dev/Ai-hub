{
  "entry": "index.html",
  "stateExpr": "window.app.state()",
  "contract": "The page must expose window.app.state() returning every piece of state it keeps.",
  "steps": [
    {
      "n": 1,
      "name": "loads with no page or console error, in its starting state",
      "do": [],
      "expect": "errors.length === 0 && JSON.stringify(state) === \"{\\\"playerA\\\":5,\\\"playerB\\\":0}\""
    },
    {
      "n": 2,
      "name": "pressing a changes the state as it already did",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":6,\\\"playerB\\\":0}\""
    },
    {
      "n": 3,
      "name": "pressing a again changes it again",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":7,\\\"playerB\\\":0}\""
    },
    {
      "n": 4,
      "name": "pressing z decreases playerA by one",
      "do": [
        {
          "key": "z"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":6,\\\"playerB\\\":0}\""
    },
    {
      "n": 5,
      "name": "pressing z again decreases it again",
      "do": [
        {
          "key": "z"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":5,\\\"playerB\\\":0}\""
    },
    {
      "n": 6,
      "name": "pressing z at the starting value does not go below it",
      "do": [
        {
          "key": "z"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":5,\\\"playerB\\\":0}\""
    },
    {
      "n": 7,
      "name": "a still works after z",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":6,\\\"playerB\\\":0}\""
    },
    {
      "n": 8,
      "name": "the reset from the first addition still works",
      "do": [
        {
          "key": "0"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":5,\\\"playerB\\\":0}\""
    },
    {
      "n": 9,
      "name": "a still works after the reset",
      "do": [
        {
          "key": "a"
        }
      ],
      "expect": "JSON.stringify(state) === \"{\\\"playerA\\\":6,\\\"playerB\\\":0}\""
    },
    {
      "n": 10,
      "name": "no page or console error was raised at any point",
      "do": [],
      "expect": "noErrors"
    }
  ]
}
