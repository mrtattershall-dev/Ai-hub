      "prompt": "Write a Python scientific calculator (add, subtract, multiply, divide, power, sqrt, sin, cos, log) with a CLI menu loop. Return only the code in one fenced block.",
      "response": "```\nimport math\n\ndef add(x, y):\n    return x + y\n\ndef subtract(x, y):\n    return x - y\n\ndef multiply(x, y):\n    return x * y\n\ndef divide(x, y):\n    if y == 0:\n        return \"Error! Division by zero.\"\n    return x / y\n\ndef power(x, y):\n    return x ** y\n\ndef sqrt(x):\n    if x < 0:\n        return \"Error! Square root of negative number.\"\n    return math.sqrt(x)\n\ndef sin(x):\n    return math.sin(math.radians(x))\n\ndef cos(x):\n    return math.cos(math.radians(x))\n\ndef log(x):\n    if x <= 0:\n        return \"Error! Logarithm of non-positive number.\"\n    return math.log10(x)\n\ndef main():\n    while True:\n        print(\"\\nScientific Calculator\")\n        print(\"1. Add\")\n        print(\"2. Subtract\")\n        print(\"3. Multiply\")\n        print(\"4. Divide\")\n        print(\"5. Power\")\n        print(\"6. Square Root\")\n        print(\"7. Sine\")\n        print(\"8. Cosine\")\n        print(\"9. Logarithm (base 10)\")\n        print(\"0. Exit\")\n        \n        choice = input(\"Enter your choice: \")\n        \n        if choice == '0':\n            print(\"Exiting the calculator.\")\n            break\n        \n        try:\n            num1 = float(input(\"Enter first number: \"))\n            if choice in ['2', '4', '5', '7', '8', '9']:\n                num2 = float(input(\"Enter second number: \"))\n        \n            if choice == '1':\n                print(f\"{num1} + {num2} = {add(num1, num2)}\")\n            elif choice == '2':\n                print(f\"{num1} - {num2} = {subtract(num1, num2)}\")\n            elif choice == '3':\n                print(f\"{num1} * {num2} = {multiply(num1, num2)}\")\n            elif choice == '4':\n                result = divide(num1, num2)\n                if isinstance(result, str):\n                    print(result)\n                else:\n                    print(f\"{num1} / {num2} = {result}\")\n            elif choice == '5':\n                print(f\"{num1} ^ {num2} = {power(num1, num2)}\")\n            elif choice == '6':\n                result = sqrt(num1)\n                if isinstance(result, str):\n                    print(result)\n                else:\n                    print(f\"sqrt({num1}) = {result}\")\n            elif choice == '7':\n                print(f\"sin({num1}) = {sin(num1)}\")\n            elif choice == '8':\n                print(f\"cos({num1}) = {cos(num1)}\")\n            elif choice == '9':\n                result = log(num1)\n                if isinstance(result, str):\n                    print(result)\n                else:\n                    print(f\"log10({num1}) = {result}\")\n            else:\n                print(\"Invalid input. Please try again.\")\n        except ValueError:\n            print(\"Invalid input. Please enter a number.\")\n\nif __name__ == \"__main__\":\n    main()\n```",
