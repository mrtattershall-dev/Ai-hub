      "prompt": "Explain what the following code does. Cover its overall purpose, then walk through the important parts.\n\nThink through this step by step. Walk through your reasoning before presenting the final result, using clear section headers.\n\nFormat code blocks with markdown fences including the language.\n\n---\n/**\n * CHARACTER PSYCHOSOCIAL SIMULATION ENGINE\n * grounded in:\n * - Big Five personality model\n * - stress-diathesis framework\n * - social determinants of health\n */\n\nexport const PERSONALITY_BASE = {\n  openness: { mean: 0.5, variance: 0.2 },\n  conscientiousness: { mean: 0.5, variance: 0.2 },\n  extraversion: { mean: 0.5, variance: 0.25 },\n  agreeableness: { mean: 0.5, variance: 0.2 },\n  neuroticism: { mean: 0.5, variance: 0.3 },\n};\n\n/**\n * ENVIRONMENTAL LOAD (real-world factors known to affect mental health outcomes)\n */\nexport const ENVIRONMENT_FACTORS = {\n  socialSupport: { weight: -0.6 },     // protective\n  traumaExposure: { weight: 0.9 },\n  financialStress: { weight: 0.8 },\n  instability: { weight: 0.7 },\n  safety: { weight: -0.5 },\n  communityDensity: { weight: 0.3 },\n};\n\n/**\n * BIOLOGICAL STATE VARIABLES (simplified neurobiology proxies)\n */\nfunction neuroState(base, env) {\n  const stress =\n    env.traumaExposure * 0.9 +\n    env.financialStress * 0.8 +\n    env.instability * 0.6 -\n    env.socialSupport * 0.7 -\n    env.safety * 0.5;\n\n  return {\n    cortisol: clamp(base.neuroticism + stress * 0.4, 0, 1),\n    dopamine: clamp(0.5 - stress * 0.3 + base.extraversion * 0.2, 0, 1),\n    serotonin: clamp(0.5 - stress * 0.2 + env.socialSupport * 0.4, 0, 1),\n  };\n}\n\n/**\n * RISK STATES (not \"types\", but probabilistic conditions)\n */\nexport const MENTAL_STATES = [\n  \"stable\",\n  \"stressed\",\n  \"anxious_state\",\n  \"depressive_state\",\n  \"impulsive_risk\",\n  \"dissociative_state\",\n];\n\n/**\n * CORE PROBABILITY ENGINE\n */\nexport function evaluateMentalState(person, env) {\n  const bio = neuroState(person, env);\n\n  const p = {};\n\n  // baseline stability\n  p.stable =\n    (1 - person.neuroticism) * 0.4 +\n    env.socialSupport * 0.3 +\n    bio.serotonin * 0.3;\n\n  // anxiety pathway (stress + high neuroticism + cortisol)\n  p.anxious_state =\n    person.neuroticism * 0.5 +\n    bio.cortisol * 0.4 +\n    env.financialStress * 0.3;\n\n  // depression pathway (low reward + low support)\n  p.depressive_state =\n    (1 - bio.dopamine) * 0.5 +\n    (1 - env.socialSupport) * 0.4;\n\n  // impulsive risk (dopamine dysregulation)\n  p.impulsive_risk =\n    bio.dopamine * 0.4 +\n    person.extraversion * 0.3 +\n    env.instability * 0.3;\n\n  // dissociation (high trauma + high stress overload)\n  p.dissociative_state =\n    env.traumaExposure * 0.6 +\n    bio.cortisol * 0.4;\n\n  return normalizeProbabilities(p);\n}\n\n/**\n * SIMULATION: WHO / WHY / WHEN / WHERE\n */\nexport function simulateTriggerEvent(person, env, event) {\n  const state = evaluateMentalState(person, env);\n\n  return {\n    who: classifyPerson(person),\n    why: dominantFactor(env, state),\n    when: event.time || \"unknown\",\n    where: env.type,\n    probabilityDistribution: state,\n    predictedOutcome: sampleState(state),\n  };\n}\n\n/**\n * CLASSIFICATION (non-clinical, just descriptor grouping)\n */\nfunction classifyPerson(p) {\n  if (p.neuroticism > 0.7) return \"high_sensitivity_profile\";\n  if (p.extraversion > 0.7) return \"high_social_drive_profile\";\n  if (p.conscientiousness > 0.7) return \"structured_control_profile\";\n  return \"balanced_profile\";\n}\n\n/**\n * helpers\n */\nfunction clamp(v, a, b) {\n  return Math.max(a, Math.min(b, v));\n}\n\nfunction normalizeProbabilities(obj) {\n  const sum = Object.values(obj).reduce((a, b) => a + b, 0);\n  for (const k in obj) obj[k] /= sum;\n  return obj;\n}\n\nfunction sampleState(p) {\n  const r = Math.random();\n  let acc = 0;\n  for (const k in p) {\n    acc += p[k];\n    if (r < acc) return k;\n  }\n  return \"stable\";\n}\n\nfunction dominantFactor(env, state) {\n  const max = Object.entries(state).sort((a, b) => b[1] - a[1])[0][0];\n  return max;\n}\nconst PERSONALITY_TYPES = [\n  {\n    id: 'social',\n    name: 'Soc",
      "response": "```js\n/**\n * CHARACTER PSYCHOSOCIAL SIMULATION ENGINE\n * grounded in:\n * - Big Five personality model\n * - stress-diathesis framework\n * - social determinants of health\n */\n\nexport const PERSONALITY_BASE = {\n  openness: { mean: 0.5, variance: 0.2 },\n  conscientiousness: { mean: 0.5, variance: 0.2 },\n  extraversion: { mean: 0.5, variance: 0.25 },\n  agreeableness: { mean: 0.5, variance: 0.2 },\n  neuroticism: { mean: 0.5, variance: 0.3 },\n};\n\n/**\n * ENVIRONMENTAL LOAD (real-world factors known to affect mental health outcomes)\n */\nexport const ENVIRONMENT_FACTORS = {\n  socialSupport: { weight: -0.6 },     // protective\n  traumaExposure: { weight: 0.9 },\n  financialStress: { weight: 0.8 },\n  instability: { weight: 0.7 },\n  safety: { weight: -0.5 },\n  communityDensity: { weight: 0.3 },\n};\n\n/**\n * BIOLOGICAL STATE VARIABLES (simplified neurobiology proxies)\n */\nfunction neuroState(base, env) {\n  const stress =\n    env.traumaExposure * 0.9 +\n    env.financialStress * 0.8 +\n    env.instability * 0.6 -\n    env.socialSupport * 0.7 -\n    env.safety * 0.5;\n\n  return {\n    cortisol: clamp(base.neuroticism + stress * 0.4, 0, 1),\n    dopamine: clamp(0.5 - stress * 0.3 + base.extraversion * 0.2, 0, 1),\n    serotonin: clamp(0.5 - stress * 0.2 + env.socialSupport * 0.4, 0, 1),\n  };\n}\n\n/**\n * RISK STATES (not \"types\", but probabilistic conditions)\n */\nexport const MENTAL_STATES = [\n  \"stable\",\n  \"stressed\",\n  \"anxious_state\",\n  \"depressive_state\",\n  \"impulsive_risk\",\n  \"dissociative_state\",\n];\n\n/**\n * CORE PROBABILITY ENGINE\n */\nexport function evaluateMentalState(person, env) {\n  const bio = neuroState(person, env);\n\n  const p = {};\n\n  // baseline stability\n  p.stable =\n    (1 - person.neuroticism) * 0.4 +\n    env.socialSupport * 0.3 +\n    bio.serotonin * 0.3;\n\n  // anxiety pathway (stress + high neuroticism + cortisol)\n  p.anxious_state =\n    person.neuroticism * 0.5 +\n    bio.cortisol * 0.4 +\n    env.financialStress * 0.3;\n\n  // depression pathway (low reward + low support)\n  p.depressive_state =\n    (1 - bio.dopamine) * 0.5 +\n    (1 - env.socialSupport) * 0.4;\n\n  // impulsive risk (dopamine dysregulation)\n  p.impulsive_risk =\n    bio.dopamine * 0.4 +\n    person.extraversion * 0.3 +\n    env.instability * 0.3;\n\n  // dissociation (high trauma + high stress overload)\n  p.dissociative_state =\n    env.traumaExposure * 0.6 +\n    bio.cortisol * 0.4;\n\n  return normalizeProbabilities(p);\n}\n\n/**\n * SIMULATION: WHO / WHY / WHEN / WHERE\n */\nexport function simulateTriggerEvent(person, env, event) {\n  const state = evaluateMentalState(person, env);\n\n  return {\n    who: classifyPerson(person),\n    why: dominantFactor(env, state),\n    when: event.time || \"unknown\",\n    where: env.type,\n    probabilityDistribution: state,\n    predictedOutcome: sampleState(state),\n  };\n}\n\n/**\n * CLASSIFICATION (non-clinical, just descriptor grouping)\n */\nfunction classifyPerson(p) {\n  if (p.neuroticism > 0.7) return \"high_sensitivity_profile\";\n  if (p.extraversion > 0.7) return \"high_social_drive_profile\";\n  if (p.conscientiousness > 0.7) return \"structured_control_profile\";\n  return \"balanced_profile\";\n}\n\n/**\n * helpers\n */\nfunction clamp(v, a, b) {\n  return Math.max(a, Math.min(b, v));\n}\n\nfunction normalizeProbabilities(obj) {\n  const sum = Object.values(obj).reduce((a, b) => a + b, 0);\n  for (const k in obj) obj[k] /= sum;\n  return obj;\n}\n\nfunction sampleState(p) {\n  const r = Math.random();\n  let acc = 0;\n  for (const k in p) {\n    acc += p[k];\n    if (r < acc) return k;\n  }\n  return \"stable\";\n}\n\nfunction dominantFactor(env, state) {\n  const max = Object.entries(state).sort((a, b) => b[1] - a[1])[0][0];\n  return max;\n}\r\n\nconst PERSONALITY_TYPES = [\r\n  {\r\n    id: 'social',\r\n    name: 'Social',\r\n    desc: `The world is about people. She seeks connection above all. Every contact lights her up.`,\r\n    traits: ['gregarious', 'empathetic', 'charming', 'talkative', 'helpful'],\r\n  },\r\n  {\r\n    id: 'creative',\r\n    name: 'Creative',\r\n    desc: `Her mind wanders to new worlds. Ideas pour from her. Aesthetics matter more than function.`,\r\n    traits: ['inspired', 'imaginative', 'artistic', 'curious', 'distracted'],\r\n  },\r\n  {\r\n    id: 'practical',\r\n    name: 'Practical',\r\n    desc: `Every thing has a place. Her hands work quietly. Efficiency trumps flair.`,\r\n    traits: ['methodical', 'organized', 'precise', 'efficient', 'conscientious'],\r\n  },\r\n  {\r\n    id: 'explorer',\r\n    name: 'Explorer',\r\n    desc: `Always looking for what's hidden. New territory is gold. Secrets drive her.`,\r\n    traits: ['adventurous', 'restless', 'observant', 'resourceful', 'reckless'],\r\n  },\r\n  {\r\n    id: 'survivor',\r\n    name: 'Survivor',\r\n    desc: `Every day is a fight. Pain teaches her. Toughness beats style every time.`,\r\n    traits: ['stoic', 'brave', 'tenacious', 'calm', 'self-sufficient'],\r\n  },\r\n];\r\n\r\nexport const NEUROTYPES = [\r\n  { id: 'stable', name: 'Stable' },\r\n  { id: 'anxious', name: 'Anxious' },\r\n  { id: 'depressed', name: 'Depressed' },\r\n  { id: 'psychotic', name: 'Psychotic' },\r\n  { id: 'sadist', name: 'Sadist' },\r\n  { id: 'masochist', name: 'Masochist' },\r\n];\r\n\r\nexport const PSYCHOLOGY = [\r\n  { id: 'normal', name: 'Normal' },\r\n  { id: 'introverted', name: 'Introverted' },\r\n  { id: 'extroverted', name: 'Extroverted' },\r\n  { id: 'sanguine', name: 'Sanguine' },\r\n  { id: 'phlegmatic', name: 'Phlegmatic' },\r\n  { id: 'choleric', name: 'Choleric' },\r\n  { id: 'impulsive', name: 'Impulsive' },\r\n  { id: 'placid', name: 'Placid' },\r\n  { id: 'resolute', name: 'Resolute' },\r\n  { id: 'cynical', name: 'Cynical' },\r\n  { id: 'hopeful', name: 'Hopeful' },\r\n];\r\n\r\n// Environmental / situational factors that influence personality\r\nexport const ENVIRONMENT = [\r\n  {\r\n    id: 'remote',\r\n    name: 'Remote',\r\n    effect: 'Everyone feels alone; sociality becomes vital.',\r\n    weight: 20,\r\n  },\r\n  {\r\n    id: 'ruined',\r\n    name: 'Ruined',\r\n    effect: 'Structures decayed; practicality reigns over style.',\r\n    weight: 15,\r\n  },\r\n  {\r\n    id: 'wilderness',\r\n    name: 'Wilderness',\r\n    effect: 'Nature defines the frontier; exploration is survival.' +\r\n      ' Restlessness drives movement. Pragmatism is survival. Creativity finds beauty in the untamed.' +\r\n      ' Anxiety grows without structure. Depression settles into the slow rhythm.' +\r\n      ' Psychosis sees shapes everywhere. Sadists find order in chaos. Masochists relish solitude.' +\r\n      ' Stoicism holds through extremes. Bravery faces danger head-on. Tenacity stays put.' +\r\n      ' Calm observes the wilderness. Self-sufficiency finds resources.' +\r\n      ' The environment shapes how someone acts.',\r\n    weight: 35,\r\n  },\r\n  {\r\n    id: 'city',\r\n    name: 'City',\r\n    effect: 'High density: socialising is essential. Noise tests composure. Beauty is ornamental.' +\r\n      ' Anxiety is comfort. Depression sinks into the crowd. Psychosis sees patterns.' +\r\n      ' Sadists value stability. Masochists dislike it. Stoicism holds through noise.' +\r\n      ' Bravery is tested. Tenacity stays put. Calm observes structure. Self-sufficiency hard.' +\r\n      ' Cities reward sociability and resilience.',\r\n    weight: 25,\r\n  },\r\n  {\r\n    id: 'haunted',\r\n    name: 'Haunted',\r\n    effect: 'Ancient, corrupt, dangerous. Fear and desperation fuel survival.' +\r\n      ' Anxiety is dread. Depression sinks. Psychosis feeds on decay.' +\r\n      ' Sadists enjoy fear. Masochists thrive on struggle. Stoicism holds through peril.' +\r\n      ' Bravery faces the unknown. Tenacity stays. Calm observes corruption. Self-sufficiency hard.' +\r\n      ' The ruins force harsh, resilient living.',\r\n    weight: 18,\r\n  },\r\n];\r\n\r\n// Societal pressures and financial dynamics affecting personality\r\nexport const FINANCE = [\r\n  {\r\n    id: 'affluent',\r\n    name: 'Affluent',\r\n    effect: 'Riches buy comfort: organisation and creativity thrive. Stability attracts.' +\r\n      ' Anxiety is comfort. Depression feels trapped. Psychosis sees order.' +\r\n      ' Sadists value stability. Masochists dislike it. Stoicism holds. Brave stays put.' +\r\n      ' Tenacity saves by saving. Calm enjoys stability. Self-sufficiency easy.' +\r\n      ' Wealth provides options and stability.',\r\n    weight: 24,\r\n  },\r\n  {\r\n    id: 'poor',\r\n    name: 'Poor',\r\n    effect: 'Short on everything: practicality and resilience shine. Creativity finds meaning.' +\r\n      ' Anxiety is scarcity. Depression feels hopeless. Psychosis sees patterns.' +\r\n      ' Sadists thrive on struggle. Masochists dislike it. Stoicism holds. Brave stays put.' +\r\n      ' Tenacity trades hard. Calm observes limits. Self-sufficiency essential.' +\r\n      ' Poverty forces frugality and resilience.',\r\n    weight: 26,\r\n  },\r\n  {\r\n    id: 'market',\r\n    name: 'Market',\r\n    effect: 'Prices fluctuate: practicality and resourcefulness are vital. Stability draws.' +\r\n      ' Anxiety is risk. Depression feels trapped. Psychosis reads charts.' +\r\n      ' Sadists trade well. Masochists hate it. Stoicism holds. Brave faces risks.' +\r\n      ' Tenacity trades hard. Calm observes trends. Self-sufficiency hard.' +\r\n      ' Market rewards practicality and adaptability.',\r\n    weight: 20,\r\n  },\r\n  {\r\n    id: 'guild',\r\n    name: 'Guild',\r\n    effect: 'Protected but rules bind: organisation and compliance are key. Stability draws.' +\r\n      ' Anxiety is bureaucracy. Depression feels stifled. Psychosis reads rules.' +\r\n      ' Sadists thrive on routine. Masochists dislike it. Stoicism holds. Brave faces red tape.' +\r\n      ' Tenacity saves by following orders. Calm observes rules. Self-sufficiency hard.' +\r\n      ' Guild life favours discipline and organisation.',\r\n    weight: 10,\r\n  },\r\n  {\r\n    id: 'bandit',\r\n    name: 'Bandit',\r\n    effect: 'Constant threat: resilience and bravery define survival. Anxiety is terror.' +\r\n      ' Depression feels abandoned. Psychosis sees enemies everywhere.' +\r\n      ' Sadists face danger. Masochists hate it. Stoicism holds. Brave faces threats.' +\r\n      ' Tenacity stays put. Calm observes danger. Self-sufficiency essential.' +\r\n      ' Bandits force confrontation and survival skills.',\r\n    weight: 10,\r\n  },\r\n];\r\n\n```",
