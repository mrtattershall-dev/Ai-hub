],\n\n// --- FISHERMAN JOHN -------------------------------------------------------------- john: [ { id:'f101', text:\"Good morning! What brings you to the dock?\", cost:18, read:false, children:['f201','f202','f203','f204'], unlocks:['f301'] }, { id:'f201', text:\"Fishing pays. The boat is yours. Sail south and find your way.\", read:false, children:['f302','f303','f304'], unlocks:['f401'] }, { id:'f202', text:\"The weather is changing. Storms come when they did before.\", read:false, children:['f305','f306','f307'], unlocks:['f402'] }, { id:'f203', text:\"The road south is slow going. Bandits raid every night.\", read:false, children:['f308','f309','f310'], unlocks:['f403'] }, { id:'f204', text:\"The village is peaceful. We trade at the market. That's all.\", read:false, children:['f311','f312','f313'], unlocks:['f404'] },\n\n{ id:'f301', text:\"The weather is changing. Storms come when they did before.\", read:false, children:['f411','f412','f413'], unlocks:['f501'] }, { id:'f302', text:\"The road south is slow going. Bandits raid every night.\", read:false, children:['f414','f415','f416'], unlocks:['f502'] }, { id:'f303', text:\"The village is peaceful. We trade at the market. That's all.\", read:false, children:['f417','f418','f419'], unlocks:['f503'] }, { id:'f304', text:\"The weather is changing. Storms come when they did before.\", read:false, children:['f420','f421','f422'], unlocks:['f504'] }, { id:'f305', text:\"The storms eat the roads. Travel slows. More dangerous.\", read:false, children:['f423','f424','f425'], unlocks:['f505'] }, { id:'f306', text:\"The road south is slow going. Bandits raid every night.\", read:false, children:['f426','f427','f428'], unlocks:['f506'] }, { id:'f307', text:\"The village is peaceful. We trade at the market. That's all.\", read:false, children:['f429','f430','f431'], unlocks:['f507'] },\r\n\r\n{ id:'f401', text:\"The weather is changing. Storms come when they did before.\", read:false, children:[], unlocks:[] }, { id:'f402', text:\"The road south is slow going. Bandits raid every night.\", read:false, children:[], unlocks:[] }, { id:'f403', text:\"The village is peaceful. We trade at the market. That's all.\", read:false, children:[], unlocks:[] }, { id:'f404', text:\"The weather is changing. Storms come when they did before.\", read:false, children:[], unlocks:[] }, { id:'f405', text:\"The storms eat the roads. Travel slows. More dangerous.\", read:false, children:[], unlocks:[] }, { id:'f406', text:\"The road south is slow going. Bandits raid every night.\", read:false, children:[], unlocks:[] }, { id:'f407', text:\"The village is peaceful. We trade at the market. That's all.\", read:false, children:[], unlocks:[] }, ] }; } getTree(npcId) { return this.trees[npcId] ?? []; } read(topicId, player) { const tree = this.getTree(player.npc); const t = tree.find((d)=>d.id===topicId); if (!t || t.read) return null; if (t.cost > 0 && player.gold < t.cost) return { ok:false, msg:'⚠️ Not enough gold.' }; if (t.cost > 0) { player.gold -= t.cost; player.busy = true; setTimeout(()=>{player.busy=false},1200); } t.read=true; const unlocks=t.unlocks??[];\r\n  const kids=tree.filter((d)=>d.children?.includes(t.id));\r\n  for(const kid of kids){const c=tree.find((d)=>d.id===kid.id);if(c)c.read=true;}\r\n  return { text:t.text, cost:t.cost, unlocked:unlocks };\r\n} }\n```",
