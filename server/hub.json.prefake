      "prompt": "Write code that satisfies the following request. Include any necessary imports and a brief usage example.\n\nThink through this step by step. Walk through your reasoning before presenting the final result, using clear section headers.\n\nFormat code blocks with markdown fences including the language.\n\n---\n{\n  \"code\": \"const W = 480, H = 360;\n\nexport class TitleScreen {\n  constructor(params) {\n    this.app = params.app;\n    this.w = W; this.h = H;\n    this.t = 0;\n    this.pulse = 1;\n    this.alpha = 1;\n    this.name = 'ROAD RAGE';\n    this.tagline = 'SHARPEN YOUR EDGE';\n    this.debt = params.debt ?? 0;\n    this.best = params.best ?? 0;\n  }\n\n  onEnter() {\n    this.t = 0;\n    this.pulse = 1;\n    this.alpha = 1;\n    document.getElementById('title-screen').classList.add('show');\n    this.app.audio.sfx('confirm');\n  }\n\n  onExit() {\n    document.getElementById('title-screen').classList.remove('show');\n  }\n\n  update(dt) {\n    this.t += dt;\n    const pulse = Math.sin(this.t * 8) * 0.05 + 1;\n    this.pulse = Math.max(0.9, Math.min(1.1, pulse));\n    this.alpha -= dt * 0.7;\n    if (this.alpha < 0) { this.onExit(); this.app.scenes.popScene(); }\n  }\n\n  render(ctx) {\n    ctx.fillStyle = '#0a0e1c';\n    ctx.fillRect(0, 0, this.w, this.h);\n\n    // Stars\n    for (let i = 0; i < 30; i++) {\n      const r = Math.random();\n      ctx.fillStyle = `rgba(${r*255},${Math.min(r*1.5,1)*255},255,${0.08+0.1*r})`;\n      ctx.beginPath(); ctx.arc(Math.random()*this.w, Math.random()*this.h, 1+r*2, 0, Math.PI*2); ctx.fill();\n    }\n\n    ctx.save();\n    ctx.scale(this.pulse, this.pulse);\n    ctx.translate((W-this.w)/2, (H-this.h)/2);\n\n    // Horizon\n    ctx.fillStyle = '#0a0e1c';\n    ctx.fillRect(0, this.h*0.55, this.w, this.h*0.45);\n    ctx.fillStyle = '#04080f';\n    ctx.fillRect(0, this.h*0.6, this.w, this.h*0.4);\n\n    // Road\n    ctx.fillStyle = '#1a2430';\n    ctx.fillRect(0, this.h*0.58, this.w, this.h*0.32);\n    ctx.fillStyle = '#0a0e1c';\n    ctx.fillRect(0, this.h*0.62, this.w, this.h*0.28);\n\n    // Road lines\n    ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1;\n    for (let l = -1; l <= 1; l+=2) {\n      ctx.beginPath(); ctx.moveTo(l*2+l*10, this.h*0.62); ctx.lineTo(l*2+l*10, this.h); ctx.stroke();\n    }\n\n    // Sky gradient\n    const gd = ctx.createLinearGradient(0,0,0,this.h*0.55);\n    gd.addColorStop(0,'rgba(0,0,20,0)'); gd.addColorStop(1,'rgba(0,0,20,0.55)');\n    ctx.fillStyle = gd; ctx.fillRect(0,0,this.w,this.h*0.55);\n\n    // Sun\n    ctx.save();\n    ctx.translate(this.w/2, this.h*0.3);\n    const angle = this.t * 0.4;\n    ctx.rotate(angle);\n    ctx.fillStyle = '#ffbe0b';\n    ctx.beginPath(); ctx.arc(0,0,30,0,Math.PI*2); ctx.fill();\n    ctx.restore();\n\n    // Mountains\n    ctx.fillStyle = '#0a0e1c';\n    ctx.beginPath(); ctx.moveTo(0,this.h*0.5); ctx.quadraticCurveTo(this.w*0.35,this.h*0.4,this.w*0.5,this.h*0.55); ctx.quadraticCurveTo(this.w*0.65,this.h*0.6,this.w,this.h*0.5); ctx.closePath(); ctx.fill();\n\n    // Fence posts\n    ctx.fillStyle = '#1a2430';\n    for (let p = -1; p <= 1; p+=2) {\n      ctx.fillRect(p*2+p*8, this.h*0.62-12, 4, 20);\n    }\n\n    // Fence rails\n    ctx.strokeStyle = 'rgba(255,255,255,0.18)'; ctx.lineWidth = 1;\n    for (let p = -1; p <= 1; p+=2) {\n      ctx.beginPath(); ctx.moveTo(p*2+p*10, this.h*0.62); ctx.lineTo(p*2+p*10, this.h*0.7); ctx.stroke();\n    }\n\n    // Road dust\n    ctx.fillStyle = 'rgba(255,255,255,0.04)';\n    for (let d = -1; d <= 1; d+=2) {\n      ctx.fillRect(d*2+d*12, this.h*0.62, 2, 6);\n    }\n\n    // Road edge\n    ctx.fillStyle = 'rgba(0,0,0,0.18)';\n    ctx.fillRect(-2, this.h*0.58, 2, this.h*0.32);\n    ctx.fillRect(this.w, this.h*0.58, 2, this.h*0.32);\n\n    // Road edge glow\n    ctx.globalAlpha = 0.18;\n    ctx.fillStyle = '#ffbe0b';\n    ctx.globalCompositeOperation = 'lighter';\n    for (let g = -1; g <= 1; g+=2) {\n      ctx.fillRect(g*2+g*12, this.h*0.62-8, 2, 16);\n    }\n    ctx.globalCompositeOperation = 'source-over';\n    ctx.globalAlpha = 1;\n\n    // Name\n    ctx.font = 'bold 32px Arial'; ctx.textAlign",
      "response": "```js\nconst W = 480, H = 360;\r\n\r\nexport class TitleScreen {\r\n  constructor(params) {\r\n    this.app = params.app;\r\n    this.w = W; this.h = H;\r\n    this.t = 0;\r\n    this.pulse = 1;\r\n    this.alpha = 1;\r\n    this.name = 'ROAD RAGE';\r\n    this.tagline = 'SHARPEN YOUR EDGE';\r\n    this.debt = params.debt ?? 0;\r\n    this.best = params.best ?? 0;\r\n  }\r\n\r\n  onEnter() {\r\n    this.t = 0;\r\n    this.pulse = 1;\r\n    this.alpha = 1;\r\n    document.getElementById('title-screen').classList.add('show');\r\n    this.app.audio.sfx('confirm');\r\n  }\r\n\r\n  onExit() {\r\n    document.getElementById('title-screen').classList.remove('show');\r\n  }\r\n\r\n  update(dt) {\r\n    this.t += dt;\r\n    const pulse = Math.sin(this.t * 8) * 0.05 + 1;\r\n    this.pulse = Math.max(0.9, Math.min(1.1, pulse));\r\n    this.alpha -= dt * 0.7;\r\n    if (this.alpha < 0) { this.onExit(); this.app.scenes.popScene(); }\r\n  }\r\n\r\n  render(ctx) {\r\n    ctx.fillStyle = '#0a0e1c';\r\n    ctx.fillRect(0, 0, this.w, this.h);\r\n\r\n    // Stars\r\n    for (let i = 0; i < 30; i++) {\r\n      const r = Math.random();\r\n      ctx.fillStyle = `rgba(${r*255},${Math.min(r*1.5,1)*255},255,${0.08+0.1*r})`;\r\n      ctx.beginPath(); ctx.arc(Math.random()*this.w, Math.random()*this.h, 1+r*2, 0, Math.PI*2); ctx.fill();\r\n    }\r\n\r\n    ctx.save();\r\n    ctx.scale(this.pulse, this.pulse);\r\n    ctx.translate((W-this.w)/2, (H-this.h)/2);\r\n\r\n    // Horizon\r\n    ctx.fillStyle = '#0a0e1c';\r\n    ctx.fillRect(0, this.h*0.55, this.w, this.h*0.45);\r\n    ctx.fillStyle = '#04080f';\r\n    ctx.fillRect(0, this.h*0.6, this.w, this.h*0.4);\r\n\r\n    // Road\r\n    ctx.fillStyle = '#1a2430';\r\n    ctx.fillRect(0, this.h*0.58, this.w, this.h*0.32);\r\n    ctx.fillStyle = '#0a0e1c';\r\n    ctx.fillRect(0, this.h*0.62, this.w, this.h*0.28);\r\n\r\n    // Road lines\r\n    ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1;\r\n    for (let l = -1; l <= 1; l+=2) {\r\n      ctx.beginPath(); ctx.moveTo(l*2+l*10, this.h*0.62); ctx.lineTo(l*2+l*10, this.h); ctx.stroke();\r\n    }\r\n\r\n    // Sky gradient\r\n    const gd = ctx.createLinearGradient(0,0,0,this.h*0.55);\r\n    gd.addColorStop(0,'rgba(0,0,20,0)'); gd.addColorStop(1,'rgba(0,0,20,0.55)');\r\n    ctx.fillStyle = gd; ctx.fillRect(0,0,this.w,this.h*0.55);\r\n\r\n    // Sun\r\n    ctx.save();\r\n    ctx.translate(this.w/2, this.h*0.3);\r\n    const angle = this.t * 0.4;\r\n    ctx.rotate(angle);\r\n    ctx.fillStyle = '#ffbe0b';\r\n    ctx.beginPath(); ctx.arc(0,0,30,0,Math.PI*2); ctx.fill();\r\n    ctx.restore();\r\n\r\n    // Mountains\r\n    ctx.fillStyle = '#0a0e1c';\r\n    ctx.beginPath(); ctx.moveTo(0,this.h*0.5); ctx.quadraticCurveTo(this.w*0.35,this.h*0.4,this.w*0.5,this.h*0.55); ctx.quadraticCurveTo(this.w*0.65,this.h*0.6,this.w,this.h*0.5); ctx.closePath(); ctx.fill();\r\n\r\n    // Fence posts\r\n    ctx.fillStyle = '#1a2430';\r\n    for (let p = -1; p <= 1; p+=2) {\r\n      ctx.fillRect(p*2+p*8, this.h*0.62-12, 4, 20);\r\n    }\r\n\r\n    // Fence rails\r\n    ctx.strokeStyle = 'rgba(255,255,255,0.18)'; ctx.lineWidth = 1;\r\n    for (let p = -1; p <= 1; p+=2) {\r\n      ctx.beginPath(); ctx.moveTo(p*2+p*10, this.h*0.62); ctx.lineTo(p*2+p*10, this.h*0.7); ctx.stroke();\r\n    }\r\n\r\n    // Road dust\r\n    ctx.fillStyle = 'rgba(255,255,255,0.04)';\r\n    for (let d = -1; d <= 1; d+=2) {\r\n      ctx.fillRect(d*2+d*12, this.h*0.62, 2, 6);\r\n    }\r\n\r\n    // Road edge\r\n    ctx.fillStyle = 'rgba(0,0,0,0.18)';\r\n    ctx.fillRect(-2, this.h*0.58, 2, this.h*0.32);\r\n    ctx.fillRect(this.w, this.h*0.58, 2, this.h*0.32);\r\n\r\n    // Road edge glow\r\n    ctx.globalAlpha = 0.18;\r\n    ctx.fillStyle = '#ffbe0b';\r\n    ctx.globalCompositeOperation = 'lighter';\r\n    for (let g = -1; g <= 1; g+=2) {\r\n      ctx.fillRect(g*2+g*12, this.h*0.62-8, 2, 16);\r\n    }\r\n    ctx.globalCompositeOperation = 'source-over';\r\n    ctx.globalAlpha = 1;\r\n\r\n    // Name\r\n    ctx.font = 'bold 32px Arial'; ctx.textAlign = 'center';\r\n    ctx.fillStyle = `rgba(255,255,255,${this.pulse})`;\r\n    ctx.fillText(this.name.toUpperCase(), 0, this.h*0.42);\r\n    ctx.fillStyle = `rgba(180,190,210,${this.pulse*0.5})`;\r\n    ctx.fillText(this.name.toUpperCase(), 0, this.h*0.42+4);\r\n\r\n    // Tagline\r\n    ctx.font = 'italic 18px Arial';\r\n    ctx.fillStyle = `rgba(180,190,210,${this.pulse})`;\r\n    ctx.fillText(this.tagline, 0, this.h*0.56);\r\n\r\n    // Debt readout\r\n    if (this.debt > 0) {\r\n      ctx.font = '11px monospace';\r\n      ctx.fillStyle = `rgba(255,80,110,${this.pulse})`;\r\n      ctx.fillText(`DEBT ${this.debt}`, 0, this.h*0.64);\r\n    }\r\n\r\n    // Best lap\r\n    if (this.best > 0) {\r\n      ctx.font = '11px monospace';\r\n      ctx.fillStyle = `rgba(80,180,100,${this.pulse})`;\r\n      ctx.fillText(`BEST LAP ${this.best}s`, 0, this.h*0.7);\r\n    }\r\n\r\n    ctx.restore();\r\n  }\r\n}\r\n\n```",
