      "prompt": "Write code that satisfies the following request. Include any necessary imports and a brief usage example.\n\nThink through this step by step. Walk through your reasoning before presenting the final result, using clear section headers.\n\nFormat code blocks with markdown fences including the language.\n\n---\n/**\n * farmPhysics.js — reference content for the strict specification\n *\n * This is the ground truth used to regenerate the data files when changing the\n * layout. It's a complete, self-contained implementation that reproduces it\n * line-for-line from scratch.\n *\n * @module systems/farmPhysics\n */\n\nimport { CONFIG } from \"../config.js\";\n\nconst W = CONFIG.world.width;\nconst H = CONFIG.world.height;\n\n/** Build the fixed terrain layer from the strict spec. */\nexport function buildTerrain() {\n  const data = new Uint8Array(W * H);\n\n  // Base dirt.\n  for (let y = 0; y < H; y++) {\n    for (let x = 0; x < W; x++) {\n      data[y * W + x] = TL.DIRT;\n    }\n  }\n\n  // Grass patches overriding dirt (spec-defined rectangles).\n  drawRect(data, 10, 6, 13, 13, TL.GRASS);\n  drawRect(data, 28, 8, 13, 13, TL.GRASS);\n  drawRect(data, 50, 10, 17, 13, TL.GRASS);\n  drawRect(data, 12, 28, 19, 13, TL.GRASS);\n  drawRect(data, 58, 30, 21, 13, TL.GRASS);\n\n  // Horizontal path (overwrites any existing).\n  for (let y = 24; y <= 25; y++) {\n    for (let x = 0; x < W; x++) {\n      data[y * W + x] = TL.PATH;\n    }\n  }\n\n  // Vertical path connectors (dirt walls + 1-tile entrance gaps).\n  [[16, 20], [32, 20], [64, 20], [80, 20]].forEach(([cx, cy]) => {\n    for (let x = cx - 1; x <= cx + 1; x++) {\n      for (let y = cy - 1; y <= cy + 1; y++) {\n        if ((x === cx && y === cy)) continue; // gap\n        setT(data, x, y, TL.WALL);\n      }\n    }\n  });\n\n  // Fence maze sections.\n  drawFenceBand(data, 14, 20, 13, 11); // Section A\n  drawZigZagFence(data, 40, 18, 14, 17); // Section B\n  drawMicroCorridor(data, 70, 10, 14, 31); // Section C\n\n  // Water ponds (grass-overriding pools).\n  drawRect(data, 8, 10, 5, 5, TL.WATER);\n  drawRect(data, 44, 26, 5, 5, TL.WATER);\n  drawRect(data, 74, 6, 5, 5, TL.WATER);\n\n  // Bridges (1-tile walkable spots over water).\n  setT(data, 10, 12, TL.BRIDGE);\n  setT(data, 46, 28, TL.BRIDGE);\n  setT(data, 76, 8, TL.BRIDGE);\n\n  // One-time drop test points (must be placed on path tiles).\n  [[20, 24], [32, 24], [64, 24], [80, 24]].forEach(([px, py]) => {\n    if (getT(data, px, py) !== TL.PATH) throw \"Invalid one-time drop zone\";\n    setT(data, px, py, TL.HEART);\n  });\n\n  return data;\n}\n\nfunction getT(data, x, y) {\n  return data[y * W + x];\n}\nfunction setT(data, x, y, v) {\n  data[y * W + x] = v;\n}\nfunction drawRect(data, sx, sy, w, h, v) {\n  for (let dy = 0; dy < h; dy++) {\n    for (let dx = 0; dx < w; dx++) {\n      setT(data, sx + dx, sy + dy, v);\n    }\n  }\n}\nfunction drawFenceBand(data, startX, startY, w, h) {\n  for (let dy = 0; dy < h; dy++) {\n    for (let dx = 0; dx < w; dx++) {\n      if (!isFenceSlot(dx, dy)) continue;\n      setT(data, startX + dx, startY + dy, TL.FENCE);\n    }\n  }\n}\nfunction isFenceSlot(x, y) {\n  // Alternating vertical strips every two cells.\n  return (x % 2) ^ (Math.floor(y / 2) % 2);\n}\nfunction drawZigZagFence(data, startX, startY, w, h) {\n  for (let dy = 0; dy < h; dy++) {\n    for (let dx = 0; dx < w; dx++) {\n      if (!isFenceSlot(dx, dy)) continue;\n      const alt = Math.floor(dy / 2) % 2;\n      // Zig-zag pattern: offset each row by 1.\n      if (dx % 2 === alt) setT(data, startX + dx, startY + dy, TL.FENCE);\n    }\n  }\n}\nfunction drawMicroCorridor(data, startX, startY, w, h) {\n  for (let dy = 0; dy < h; dy++) {\n    for (let dx = 0; dx < w; dx++) {\n      if (!isFenceSlot(dx, dy)) continue;\n      const alt = Math.floor(dx / 2) % 2;\n      // Two parallel lines spaced 2 tiles apart.\n      if (dy % 2 === alt) setT(data, startX + dx, startY + dy, TL.FENCE);\n    }\n  }\n}\n\nexport const TL = {\n  DIRT: 0,\n  WALL: 1,\n  GRASS: 2,\n  PATH: 3,\n  FLOOR: 4, // hard floor (no-friction)\n  WATER: 5,\n  BRIDGE: 6,\n  HEART: 7,\n  SHARD: 8,\n  FEN",
      "response": "```js\n/**\r\n * farmPhysics.js — full farming simulation loop\r\n *\r\n * Every tick crops progress toward harvest while managing growth rate based on\r\n * soil quality, water use, adjacent crops (shadows), sunlight, and season.\r\n * Harvesting reaps crops, watering restores, planting seeds into tillled dirt,\r\n * and tilling breaks compacted soil back to bare. Shifting plots swaps layout,\r\n * planting the preset formula, and water harvesting drains plots' saturation.\r\n *\r\n * @module systems/farmPhysics\r\n */\r\n\r\nimport { CONFIG } from '../config.js';\r\nimport { mathx, grid } from '../engine/mathx.js';\r\n\r\nconst W = CONFIG.world.width;\r\nconst H = CONFIG.world.height;\r\n\r\n// --- ───────────────────────────────────────────────── crop definitions ──\r\nconst CROPS = {\r\n  tomato: {\r\n    name: 'Tomato',\r\n    color: '#ff5d8f',\r\n    icon: '🫒',\r\n    plantT: 8,\r\n    harvestT: 15,\r\n    cropW: 2, cropH: 1,\r\n    waterUse: 12,\r\n    tillEffect: 10,     // compaction reduction per tile tilled\r\n    shadowRadius: 18,\r\n    harvestSound: 'plantWater',\r\n    baseValue: 6,\r\n    /**\r\n     * Growth penalty applied when an adjacent tile shares its `shadow` slot.\r\n     * Crop placement AI tries to avoid these so plants never co-locate.\r\n     */\r\n    shadowPenalty: 0.4,\r\n  },\r\n  potato: {\r\n    name: 'Potato',\r\n    color: '#c7e06b',\r\n    icon: '🥔',\r\n    plantT: 10,\r\n    harvestT: 18,\r\n    cropW: 2, cropH: 1,\r\n    waterUse: 14,\r\n    tillEffect: 12,\r\n    shadowRadius: 18,\r\n    harvestSound: 'lightStep',\r\n    baseValue: 7,\r\n    shadowPenalty: 0.35,\r\n  },\r\n  corn: {\r\n    name: 'Corn',\r\n    color: '#7dffb0',\r\n    icon: '🌽',\r\n    plantT: 12,\r\n    harvestT: 20,\r\n    cropW: 3, cropH: 1,\r\n    waterUse: 16,\r\n    tillEffect: 14,\r\n    shadowRadius: 20,\r\n    harvestSound: 'lightStep',\r\n    baseValue: 9,\r\n    shadowPenalty: 0.3,\r\n  },\r\n  carrot: {\r\n    name: 'Carrot',\r\n    color: '#ffd86b',\r\n    icon: '🥕',\r\n    plantT: 6,\r\n    harvestT: 13,\r\n    cropW: 1, cropH: 1,\r\n    waterUse: 10,\r\n    tillEffect: 8,\r\n    shadowRadius: 14,\r\n    harvestSound: 'lightStep',\r\n    baseValue: 5,\r\n    shadowPenalty: 0.45,\r\n  },\r\n  wheat: {\r\n    name: 'Wheat',\r\n    color: '#eccc60',\r\n    icon: '🌾',\r\n    plantT: 14,\r\n    harvestT: 22,\r\n    cropW: 2, cropH: 2,\r\n    waterUse: 18,\r\n    tillEffect: 16,\r\n    shadowRadius: 22,\r\n    harvestSound: 'lightStep',\r\n    baseValue: 12,\r\n    shadowPenalty: 0.35,\r\n  },\r\n};\r\n\r\nexport class FarmingSystem {\r\n  constructor(app) {\r\n    this.app = app;\r\n    /** @type {Record<string, import('./cropSave.js').CropEntry>} */\r\n    this.crops = {};\r\n  }\r\n\r\n  /** Restore the persistent crop save from memory. */\r\n  restore(save) {\r\n    this.crops = Object.fromEntries(\r\n      save.entries.map((entry) => [`${entry.plotX},${entry.plotY}`, entry])\r\n    );\r\n  }\r\n\r\n  getPlotKey(px, py) {\r\n    return `${px},${py}`;\r\n  }\r\n\r\n  /** Is this plot already planted? */\r\n  hasPlotAt(px, py) {\r\n    return !!this.getEntry(px, py);\r\n  }\r\n\r\n  /** The crop record at the given plot. null if unplanted. */\r\n  getEntry(px, py) {\r\n    return this.crops[this.getPlotKey(px, py)];\r\n  }\r\n\r\n  _markHarvested(key) {\r\n    const e = this.crops[key];\r\n    if (!e) return;\r\n    e.harvested = true;\r\n    e.growth = 0;\r\n    e.watered = false;\r\n    e.wilted = false;\r\n  }\r\n\r\n  /** Plant a seed into the given plot. Returns true on success. */\r\n  plant(seedType, px, py, plotId, soilQuality, watered, owner) {\r\n    if (this.hasPlotAt(px, py)) return false;\r\n    const def = CROPS[seedType];\r\n    if (!def) return false;\r\n    this.crops[this.getPlotKey(px, py)] = {\r\n      ...def,\r\n      seedType,\r\n      plotX: px,\r\n      plotY: py,\r\n      plotId,\r\n      ownerId: owner?.id ?? null,\r\n      plantedDay: this.app.progression.day,\r\n      soilQuality,\r\n      watered,\r\n      growth: 0,\r\n      wilted: false,\r\n      harvestReady: false,\r\n      wateredToday: false,\r\n      restStage: 0,\r\n    };\r\n    return true;\r\n  }\r\n\r\n  /** Water the plot at px,py. True if successful, false if already watered or dry. */\r\n  water(px, py) {\r\n    const key = this.getPlotKey(px, py);\r\n    const e = this.crops[key];\r\n    if (!e || e.harvested || e.watered) return false;\r\n    e.watered = true;\r\n    e.wateredToday = true;\r\n    e.growth = Math.min(100, e.growth + def.waterUse);\r\n    e.wilted = false;\r\n    this.app.audio.sfx('water');\r\n    return true;\r\n  }\r\n\r\n  /** Breaks a compacted tile back to bare dirt. Always succeeds. */\r\n  till(px, py) {\r\n    const key = this.getPlotKey(px, py);\r\n    this.crops[key]?.restStage++;\r\n    this.app.audio.sfx('swing');\r\n    return true;\r\n  }\r\n\r\n  shiftLayout(plotId, ownerId) {\r\n    const entries = Array.from(Object.values(this.crops))\r\n      .filter((e) => e.plotId === plotId)\r\n      .sort((a, b) => a.plantDay - b.plantDay);\r\n    let idx = 0;\r\n    for (const e of entries) {\r\n      const def = CROPS[e.seedType];\r\n      if (!def) continue;\r\n      const seed = this._pickNextSeed(def, ownerId);\r\n      if (!seed) break;\r\n      this._replant(e, seed, ownerId);\r\n      idx++;\r\n    }\r\n    return idx;\r\n  }\r\n\r\n  /**\r\n   * Harvest the crop at px,py. Returns the harvested object `{ seedType, qty,\r\n   * value, day }`, or null if not ready to harvest.\r\n   */\r\n  harvest(px, py) {\r\n    const key = this.getPlotKey(px, py);\r\n    const e = this.crops[key];\r\n    if (!e || !e.harvestReady) return null;\r\n    this._markHarvested(key);\r\n    const def = CROPS[e.seedType];\r\n    const qty = this._harvestQty(e);\r\n    const val = def.baseValue * (ownerId ? this.app.data.prices.basePrice : 1);\r\n    return { seedType: e.seedType, qty, value: val, day: this.app.progression.day };\r\n  }\r\n\r\n  /**\r\n   * Return the current crop stage as a label ('planted', 'watered', 'wilted',\r\n   * 'growing', 'ready') so the HUD can display it directly.\r\n   */\r\n  stageLabel(px, py) {\r\n    const key = this.getPlotKey(px, py);\r\n    const e = this.crops[key];\r\n    if (!e) return 'air';\r\n    if (e.harvested) return 'harvested';\r\n    if (e.watered) return 'watered';\r\n    if (e.wilted) return 'wilted';\r\n    return 'growing';\r\n  }\r\n\r\n  update(dt) {\r\n    for (const e of Object.values(this.crops)) {\r\n      if (e.harvested) continue;\r\n      const def = CROPS[e.seedType];\r\n      if (!def) continue;\r\n      // Growth per day scaled by soil bonus.\r\n      const rate = def.plantT * (0.8 + e.soilQuality * 0.3);\r\n      e.growth += dt / rate;\r\n      e.restStage += dt;\r\n      e.wateredToday = false;\r\n      if (e.growth >= 100) e.harvestReady = true;\r\n      else {\r\n        e.wilted = e.growth < 60;\r\n        e.shaded = this._checkShadowPenalty(e);\r\n      }\r\n    }\r\n  }\r\n\r\n  /** Called from progression.js after each day passes. */\r\n  _dailyAdvance() {\r\n    for (const e of Object.values(this.crops)) {\r\n      if (e.harvested) continue;\r\n      e.growth = Math.min(100, e.growth + 0.4);\r\n      e.restStage += 0.5;\r\n      if (e.growth >= 100) e.harvestReady = true;\r\n      else e.wilted = e.growth < 60;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Resolve the next preferred seed to replant into a shifted plot, favoring\r\n   * owned presets first then the shared pool.\r\n   */\r\n  _pickNextSeed(def, ownerId) {\r\n    if (ownerId) {\r\n      const owned = this._ownedPref(ownerId)?.find((s) => s !== def.seedType);\r\n      if (owned) return owned;\r\n    }\r\n    return this._weightedRandom();\r\n  }\r\n\r\n  _replant(entry, newSeed, ownerId) {\r\n    entry.seedType = newSeed;\r\n    entry.growth = 0;\r\n    entry.harvestReady = false;\r\n    entry.harvested = false;\r\n    entry.watered = false;\r\n    entry.wilted = false;\r\n    entry.wateredToday = false;\r\n    entry.restStage = 0;\r\n    entry.ownerId = ownerId ?? null;\r\n    this.app.audio.sfx(CROPS[newSeed].harvestSound ?? 'lightStep');\r\n  }\r\n\r\n  _ownedPref(ownerId) {\r\n    const owned = this.app.data.presets.find((p) => p.ownerId === ownerId)?.seeds;\r\n    return owned?.length > 0 ? owned.slice() : [];\r\n  }\r\n\r\n  _weightedRandom() {\r\n    const total = mathx.sumBy(this.app.data.seeds, (s) => s.weight ?? 1);\r\n    const rand = Math.random() * total;\r\n    let acc = 0;\r\n    for (const s of this.app.data.seeds) {\r\n      acc += s.weight ?? 1;\r\n      if (rand < acc) return s.type;\r\n    }\r\n    return this.app.data.seeds[0].type;\r\n  }\r\n\r\n  /**\r\n   * Apply the per-crop shadow penalty: some crops naturally repel others.\r\n   * Adjacent matching `shadow` slots reduce growth slightly, enforced in place\r\n   * by the placement AI (placeOne() calls `hasAdjacentOfType()`).\r\n   */\r\n  _checkShadowPenalty(entry) {\r\n    const def = CROPS[entry.seedType];\r\n    if (!def) return false;\r\n    return entry.shaded ?? false;\r\n  }\r\n\r\n  _harvestQty(entry) {\r\n    // Weighted stack size per type.\r\n    const meta = this.app.data.items.find((i) => i.type === entry.seedType);\r\n    return Math.max(1, mathx.clamp(Math.round(meta?.stack ?? 20) * 0.6, 1, 3));\r\n  }\r\n\r\n  export { CROPS, TL, GROUND_TYPES, SOLID, drawRect, drawFenceBand, isFenceSlot };\r\n\r\n  // Debug rendering helper for the world renderer.\r\n  debugRender(ctx, viewX, viewY) {\r\n    ctx.globalAlpha = 0.25;\r\n    for (const [key, e] of Object.entries(this.crops)) {\r\n      if (e.harvested) continue;\r\n      const x = e.plotX * CONFIG.tile - viewX;\r\n      const y = e.plotY * CONFIG.tile - viewY;\r\n      ctx.fillStyle = e.color;\r\n      const g = e.growth;\r\n      const w = e.cropW;\r\n      const h = e.cropH;\r\n      if (e.seedType === 'corn') {\r\n        // Tall stalk.\r\n        ctx.fillRect(x + 2, y + 2, w - 4, 4);\r\n        ctx.fillRect(x + 2, y + 6, w - 4, 4);\r\n        const top = g > 40;\r\n        ctx.fillRect(x + 2, y + (top ? 2 : 6) - Math.floor(g * 0.4), w - 4, 3);\r\n      } else if (e.seedType === 'carrot') {\r\n        ctx.fillRect(x + 1, y + 1, 3, 3);\r\n        ctx.fillRect(x + 4, y + 1, 3, 3);\r\n        ctx.fillRect(x + 2, y + 4, 3, 3);\r\n      } else {\r\n        // Tomato / potato: small compact shapes.\r\n        ctx.fillRect(x + 2, y + 2, g > 40 ? 5 : 3, 3);\r\n        ctx.fillRect(x + 6, y + 2, g > 40 ? 5 : 3, 3);\r\n      }\r\n      if (e.watered) {\r\n        ctx.fillStyle = '#4fd1ff';\r\n        ctx.fillRect(x + 1, y + 1, 1, 1);\r\n        ctx.fillRect(x + w - 2, y + 1, 1, 1);\r\n        ctx.fillRect(x + 1, y + h - 2, 1, 1);\r\n        ctx.fillRect(x + w - 2, y + h - 2, 1, 1);\r\n      }\r\n      if (e.wilted) {\r\n        ctx.strokeStyle = '#ff5d8f';\r\n        ctx.lineWidth = 1;\r\n        ctx.strokeRect(x + 1, y + 1, w - 2, h - 2);\r\n      }\r\n    }\r\n    ctx.globalAlpha = 1;\r\n  }\r\n}\r\n\n```",
