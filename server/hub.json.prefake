tx.globalAlpha = 1;\r\n\r\n    // Name\r\n    ctx.font = 'bold 32px Arial'; ctx.textAlign = 'center';\r\n    ctx.fillStyle = `rgba(255,255,255,${this.pulse})`;\r\n    ctx.fillText(this.name.toUpperCase(), 0, this.h*0.42);\r\n    ctx.fillStyle = `rgba(180,190,210,${this.pulse*0.5})`;\r\n    ctx.fillText(this.name.toUpperCase(), 0, this.h*0.42+4);\r\n\r\n    // Tagline\r\n    ctx.font = 'italic 18px Arial';\r\n    ctx.fillStyle = `rgba(180,190,210,${this.pulse})`;\r\n    ctx.fillText(this.tagline, 0, this.h*0.56);\r\n\r\n    // Debt readout\r\n    if (this.debt > 0) {\r\n      ctx.font = '11px monospace';\r\n      ctx.fillStyle = `rgba(255,80,110,${this.pulse})`;\r\n      ctx.fillText(`DEBT ${this.debt}`, 0, this.h*0.64);\r\n    }\r\n\r\n    // Best lap\r\n    if (this.best > 0) {\r\n      ctx.font = '11px monospace';\r\n      ctx.fillStyle = `rgba(80,180,100,${this.pulse})`;\r\n      ctx.fillText(`BEST LAP ${this.best}s`, 0, this.h*0.7);\r\n    }\r\n\r\n    ctx.restore();\r\n  }\r\n}\"\n```",
